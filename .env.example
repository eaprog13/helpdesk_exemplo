# ──────────────────────────────────────────────────────────────────────────
# SUPABASE  (Base de Dados + Autenticação)
# Criar projeto em https://supabase.com → Project Settings → API
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # chave pública (anon) — segura para o browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # chave privada — APENAS no servidor, nunca expor ao browser

# ──────────────────────────────────────────────────────────────────────────
# LLM — fornecedor 100% configurável, sem alterar código (ver
# src/composition/container.ts, o único ficheiro que lê esta variável).
# LLM_PROVIDER = "anthropic" | "openai" | "gemini" | "groq"
# Só é obrigatório preencher a chave do fornecedor escolhido.
# ──────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini

# Gemini Developer API — chave gerada em https://aistudio.google.com/apikey
# (Google AI Studio). Não confundir com Vertex AI (GCP, service account) —
# essa não está implementada aqui.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# GroqCloud — chave gerada em https://console.groq.com/keys. API
# compatível com a da OpenAI (mesmo adaptador reutiliza o SDK "openai",
# só a apontar para outro endpoint — ver src/adapters/llm/groqProvider.ts).
# A Groq descontinua modelos com frequência — confirmar os disponíveis em
# https://console.groq.com/docs/models (ou GET /openai/v1/models) antes
# de mudar; um nome desatualizado dá 404 "model_not_found".
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# "Lapidar" (embelezar) pela LLM texto já correto/aprovado — histórico,
# base de conhecimento, saudação fixa, aviso de ticket aberto — para soar
# mais natural à pergunta concreta que foi feita, sem mudar factos (ver
# src/core/services/chatService.ts, lapidarSeAtivo). É o ÚNICO papel da
# LLM no chat: nunca responde com o seu próprio conhecimento. Ativo por
# omissão — só pôr a false como interruptor de emergência (ex.:
# fornecedor de LLM em baixo ou a dar problemas).
RESPOSTA_HUMANIZADA_ATIVA=true

# ──────────────────────────────────────────────────────────────────────────
# EMAIL — Resend (https://resend.com)
# ──────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Apoio ao Cliente Vértice Digital <suporte@vertice-digital.example>"

# ──────────────────────────────────────────────────────────────────────────
# WHATSAPP — Twilio (https://www.twilio.com/whatsapp)
# ──────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886     # número aprovado/sandbox Twilio
WHATSAPP_NOTIFICATIONS_ENABLED=false           # true assim que o número/templates estiverem aprovados

# ──────────────────────────────────────────────────────────────────────────
# SEGURANÇA
# ──────────────────────────────────────────────────────────────────────────
# Origens autorizadas a chamar a API (separadas por vírgula). Em produção
# colocar apenas o(s) domínio(s) reais da aplicação.
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (opcional, recomendado em produção) — Upstash Redis
# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL pública da aplicação (usada em emails/links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
